# Application Metadata
APP_NAME=Pioneer Flow Billing ERP
APP_VERSION=1.0.0
APP_ENV=production

# Data Provider Configuration (Supported: excel | Future: tally, postgres, api)
DATA_PROVIDER=excel

# Database & File Storage Paths
DATABASE_PATH=db/database.db
EXPORTS_DIR=exports
UPLOADS_DIR=uploads
LOGS_DIR=logs

# Reference Source Spreadsheet Files
STOCK_EXCEL_PATH=group order status.xlsx
COST_EXCEL_PATH=cost_data.xlsx

# Business & Company Defaults
COMPANY_NAME=Pioneer Technology
COMPANY_SUBTITLE=Mechanical & Industrial Billing Solutions
COMPANY_FOOTER=Thank you for your business! | Pioneer Technology
DEFAULT_GST_RATE=18.0
DEFAULT_PAYMENT_TERMS=Net 30 Days
DEFAULT_MAKE=WAGO
DEFAULT_UNIT=PCS

# Seller Identity & Contact - shown on invoice/quotation PDFs.
# Update these with your real registered business details.
COMPANY_ADDRESS=123 Industrial Estate Road, Andheri East, Mumbai, Maharashtra 400069, India
COMPANY_GSTIN=27AAAAA0000A1Z5
COMPANY_PAN=AAAAA0000A
COMPANY_PHONE=+91 22 0000 0000
COMPANY_EMAIL=accounts@pioneertechnology.example
COMPANY_WEBSITE=www.pioneertechnology.example

# Bank Details for payment instructions on invoices.
# Update these with your real account details.
BANK_NAME=HDFC Bank
BANK_ACCOUNT_NAME=Pioneer Technology
BANK_ACCOUNT_NUMBER=000000000000
BANK_IFSC=HDFC0000000
BANK_BRANCH=Andheri East, Mumbai
